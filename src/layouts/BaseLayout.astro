---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = '/' } = Astro.props;
const canonical = new URL(path, site.url).toString();
const pageTitle = title === site.name ? `${site.name} — ${site.tagline}` : `${title} — ${site.name}`;
const nav = [
  { href: '/products/', label: 'Products' },
  { href: '/ecosystem/', label: 'Ecosystem' },
  { href: '/showcase/', label: 'Showcase' },
  { href: '/docs/', label: 'Docs' },
  { href: '/contribute/', label: 'Contribute' }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080808" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/images/playmaker.png', site.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/images/favicon.png" type="image/png" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="PlayMAKER home"><img class="brand-logo" src="/images/playmaker-logo.webp" alt="" width="44" height="44" /><span>Play<span>MAKER</span></span></a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {nav.map((item) => <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <a class="header-github" href={site.orgUrl} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <details class="mobile-menu">
          <summary aria-label="Open navigation"><span></span><span></span><span></span></summary>
          <nav aria-label="Mobile navigation">
            {nav.map((item) => <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>)}
            <a href={site.orgUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-top">
        <div><a class="brand footer-brand" href="/" aria-label="PlayMAKER home"><img class="brand-logo" src="/images/playmaker-logo.webp" alt="" width="44" height="44" /><span>Play<span>MAKER</span></span></a><p>Every sport. Every level. Your way.</p></div>
        <div class="footer-links"><a href="/products/">Products</a><a href="/docs/">Docs</a><a href="/ecosystem/">Ecosystem</a><a href="/showcase/">Showcase</a></div>
        <div class="footer-links"><a href="/contribute/">Contribute</a><a href="/privacy/">Privacy & licensing</a><a href={site.orgUrl} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div>
      </div>
      <div class="shell footer-bottom"><span>© {new Date().getFullYear()} PlayMAKER. Built in the open.</span><span>For teams of every size.</span></div>
    </footer>
  </body>
</html>
