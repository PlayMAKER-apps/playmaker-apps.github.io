---
import type { Product } from '../data/site';
const { product } = Astro.props as { product: Product };
---
<article class={`product-card accent-${product.accent}`}>
  <div class="product-visual">
    <div class="visual-grid" aria-hidden="true"></div>
    <span class="visual-index">/{product.index}</span>
    <img src={product.image} alt={`${product.name} artwork`} width="340" height="340" loading="lazy" decoding="async" />
  </div>
  <div class="product-info">
    <div class="product-topline"><span>{product.eyebrow}</span><span class="status">{product.status}</span></div>
    <h3>{product.name}</h3>
    <p class="product-tagline">{product.tagline}</p>
    <p class="product-description">{product.description}</p>
    <div class="product-actions"><a class="text-link" href={`/products/${product.slug}/`}>Explore product <span aria-hidden="true">↗</span></a>{product.repoUrl && <a class="subtle-link" href={product.repoUrl} target="_blank" rel="noopener noreferrer">{product.slug === 'webmaker' ? 'Pilot code' : 'GitHub repo'} ↗</a>}</div>
  </div>
</article>
